Set Mismatch






class Solution {
    static{
        for(int i = 0 ; i<300 ; i++){
            findErrorNums(new int[0]);
        }
    }
    public static int[] findErrorNums(int[] nums) {
        int a[] = new int[nums.length+1];
        // Arrays.sort(nums);
        int b[] = new int[2];
        int arrayLength = nums.length;
        for(int i=0;i<arrayLength;i++){
            a[nums[i]]++;
        }
        for(int i=1;i<=arrayLength;i++){
            if(a[i] == 0)
            {
                b[1]=i;
            }
            if(a[i]>1)
            {
                b[0] = i;
            }
        }
        
    return b;
    }
}
